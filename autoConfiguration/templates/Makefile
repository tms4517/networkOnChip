# @TOP@: generated by autoConfiguration/nocGen.py from @CONFIG@. DO NOT EDIT.
#
#   make lint   Verilator -Wall + svlint on the generated top
#   make sim    build and run the self-checking testbench (Verilator --timing)
#   make synth  generic Yosys synthesis (needs the yosys-slang plugin)
#   make all    lint, sim and synth

TOP = @TOP@
TB_TOP = tb_$(TOP)
RTL_FILE_LIST = rtl/$(TOP).f
TB_FILE_LIST = tb/$(TB_TOP).f
BUILD_DIR ?= build
# The testbench uses --timing: CXX must support C++20 coroutines (GCC >= 10).
# Optional libstdc++ to LD_PRELOAD when the yosys-slang plugin needs one.
YOSYS_SLANG_LIBSTDCPP ?=

RTL_FILES = $(wildcard rtl/*.sv)
TB_FILES = $(wildcard tb/*.sv)
SIM_BINARY = $(BUILD_DIR)/sim/V$(TB_TOP)

.PHONY: all
all: lint sim synth

.PHONY: lint
lint:
	verilator --lint-only -Wall -F $(RTL_FILE_LIST) --top-module $(TOP)
	svlint -c .svlint.toml rtl/$(TOP).sv

.PHONY: sim
sim: $(SIM_BINARY)
	./$(SIM_BINARY)

$(SIM_BINARY): $(RTL_FILES) $(TB_FILES) $(RTL_FILE_LIST) $(TB_FILE_LIST)
	mkdir -p $(BUILD_DIR)/sim
	verilator --binary --timing -Wall --timescale 1ns/1ps \
	  -F $(RTL_FILE_LIST) -F $(TB_FILE_LIST) --top-module $(TB_TOP) \
	  -Mdir $(BUILD_DIR)/sim \
	  -MAKEFLAGS "CXX=$(CXX) LINK=$(CXX) CFG_CXXFLAGS_PCH_I=-include" \
	  -CFLAGS -std=c++20 -LDFLAGS "-pthread -static-libstdc++"

.PHONY: synth
synth:
	mkdir -p $(BUILD_DIR)/synth
	env $(if $(YOSYS_SLANG_LIBSTDCPP),LD_PRELOAD=$(YOSYS_SLANG_LIBSTDCPP)) \
	  yosys -m slang -s synth/yosys.ys -l $(BUILD_DIR)/synth/yosys.log

.PHONY: clean
clean:
	rm -rf $(BUILD_DIR)
